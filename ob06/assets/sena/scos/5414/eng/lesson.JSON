_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "A Day in Japantown", "type": "lesson_name"}, {"content": "What Should I Get?", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "scholar > Legend Has It... > Japan", "type": "origin"}, {"content": 11, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"content": "engenn4le11ob06re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Talking About Food - Made From vs. Made Of", "type": "heading"}, {"content": "You use the word <span class=\"italic\">ingredient</span>  to talk about what foods are used to make a dish.<br><br>For example: <br>The ingredients of cream are: milk, sugar and eggs. <br><br>You use <span class=\"italic\">made</span> and the preposition <span class=\"italic\"> of </span> to talk about ingredients that don't change their original form. <br><br><span class=\"italic\">The shu-cream is made of pastry and cream.</span>  (You can still see the pastry and the cream). <br><br>You use <span class=\"italic\">made and the preposition from</span>  to talk about ingredients that change their form.", "type": "describer"}, {"content": "Wine is made from grapes. ", "type": "example"}, {"content": "Mochi is made from rice.", "type": "example"}, {"content": "What are they made of?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "delectable ", "type": "name"}, {"content": "delicious", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The shu-creams are delectable.", "type": "example"}, {"content": "engenn4le11ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use at a bakery.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "pastry", "type": "name"}, {"content": "a dough made from flour used in baked goods ", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: They are made of pastry and cream.", "type": "example"}, {"content": "engenn4le11ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "dozen ", "type": "name"}, {"content": "twelve ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Can I please have a dozen cookies?", "type": "example"}, {"content": "engenn4le11ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "chewy ", "type": "name"}, {"content": "describes a food that you bite for a long time", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: This mochi is chewy!", "type": "example"}, {"content": "engenn4le11ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sample ", "type": "name"}, {"content": "a small amount to show taste ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You should try a sample of the mochi.", "type": "example"}, {"content": "engenn4le11ob06aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to pick up ", "type": "name"}, {"content": "to get something from a store ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I want to pick up some desserts.", "type": "example"}, {"content": "engenn4le11ob06aud07", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": " Asking For and Giving Advice", "type": "heading"}, {"content": "You can use the <span class=\"strong\">Wh-question</span> ... <span class=\"italic\">What should I do?</span>  to ask for advice.<br/> You can use the <span class=\"strong\">modals</span> <span class=\"italic\">should </span> and <span class=\"italic\">could</span>  to give advice.", "type": "describer"}, {"content": "You should try these shu-creams.", "type": "example"}, {"content": "You could try the sample.", "type": "example"}, {"content": "What should I get? ", "type": "example"}, {"content": "Who should I ask?", "type": "example"}, {"content": "Where do you think I should go?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to die for", "type": "name"}, {"content": "very delicious ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: These desserts are to die for.", "type": "example"}, {"content": "engenn4le11ob06aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Choose two desserts. ", "type": "text"}, {"content": "Make a list of the ingredients of each.", "type": "text"}, {"content": "Talk about the desserts.", "type": "text"}, {"content": "Tell your partner about them.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use <span class=\"italic\">made of</span> or <span class=\"italic\">made from</span> when describing my favorite desserts.", "type": "text"}, {"content": "I make a list of ingredients for my favorite desserts.", "type": "text"}, {"content": "I talk about ingredients with my partner. ", "type": "text"}]}]}