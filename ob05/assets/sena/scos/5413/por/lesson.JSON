content\\\": \\\"opposite something\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"italic\">Go through the revolving doors.<br> It's inside the building.<br> Next to the stairs.<br> On the second floor.<br> It's across from the elevators.<br> In the basement</span>.<br>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "tricky"}, {"type": "definition", "content": "difficult "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The directions are a little tricky."}, {"type": "audio", "content": "engenn4le11ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear when asking for directions."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "quick "}, {"type": "definition", "content": "sudden"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Make a quick right."}, {"type": "audio", "content": "engenn4le11ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "You got it."}, {"type": "definition", "content": "that's right; you are correct"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: <span class=\"strong\">Anjali</span>: The bakery is this way? <span class=\"strong\">Beth</span>: You got it."}, {"type": "audio", "content": "engenn4le11ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "lights"}, {"type": "definition", "content": "street signals (red, yellow and green lights to tell drivers to stop and go)"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Take a right at the lights."}, {"type": "audio", "content": "engenn4le11ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "revolving doors"}, {"type": "definition", "content": "doors that turn